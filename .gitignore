# Ambiente virtual
venv/
__pycache__/
*.pyc

# Dataset (arquivos grandes não devem ir pro Git)
dataset/raw/*
!dataset/raw/.gitkeep
!dataset/raw/UNSW_NB15_testing-set.csv
dataset/processed/*
!dataset/processed/.gitkeep

# Modelos e artefatos gerados
models/*
!models/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Exceções: arquivos que a hospedagem (Render) precisa receber pelo Git
!models/best_model.joblib
!artifacts/input_schema.json
!artifacts/model_metadata.json

# Logs
logs/*
!logs/.gitkeep

# Ambiente/IDE
.env
.vscode/
.idea/

# Node (frontend, mais pra frente)
frontend/node_modules/

# Logs internos gerados pelo CatBoost durante o treinamento
catboost_info/

# Banco de dados local do histórico de análises
artifacts/history.db