# Ambiente virtual
venv/
__pycache__/
*.pyc

# Dataset (arquivos grandes não devem ir pro Git)
dataset/raw/*
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep

# Modelos e artefatos gerados
models/*
!models/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Ambiente/IDE
.env
.vscode/
.idea/

# Node (frontend, mais pra frente)
frontend/node_modules/

# Logs internos gerados pelo CatBoost durante o treinamento
catboost_info/

# Banco de dados local do histórico de análises
artifacts/history.db